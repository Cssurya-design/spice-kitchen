{
  "rewrites": [
    {
      "source": "/api/users/upload_avatar",
      "destination": "/api/api-form"
    },
    {
      "source": "/api/categories",
      "destination": "/api/api-form"
    },
    {
      "source": "/api/food-items",
      "destination": "/api/api-form"
    },
    {
      "source": "/api/settings",
      "destination": "/api/api-form"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/api-json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
